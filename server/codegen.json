{
  "overwrite":true,
  "schema": "./src/schemas/schema.graphql",
  "generates": {
    "src/generated/shema.ts": {
      "plugins":["typescript","typescript-resolvers"],
      "config": {
        "skipTypename": true,
        "mappers": {
          "Company": "./src/ts/entities/company.entity#CompanyEntity",
          "Job": "./src/ts/entities/job.entity#JobEntity",
          "JobList": "./src/ts/entities/job.entity#JobList",
          "Candidate": "./src/ts/entities/candidate.entity#CandidateEntity",
          "Message": "./src/ts/entities/chat.entity#MessageEntity",
          "Chat": "./src/ts/entities/chat.entity#ChatEntity",
          "Response": "./src/ts/entities/job.entity#ResponseEntity"
        }
      }
    }
  }
}